# ====================================================================
# TapTime — ตัวแปรสภาพแวดล้อม (ไฟล์ "ตัวอย่าง")
#
# ⚠️ ห้ามใส่ค่าจริงในไฟล์นี้เด็ดขาด — ไฟล์นี้ถูก commit ขึ้น git
#    ค่าจริงให้ใส่ใน .env.local เท่านั้น (ถูก .gitignore ไว้แล้ว)
#
#   cp .env.local.example .env.local     # ใช้ cp ไม่ใช่ mv
#
# ค่าเดียวกันนี้ต้องใส่ใน Vercel → Settings → Environment Variables ด้วย
# ====================================================================

# --- Supabase (Project Settings → API) ---

# URL ของโปรเจกต์ เช่น https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (ใช้ตอน login และหน้าตั้งรหัสผ่าน)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — ห้ามเผยแพร่! ใช้เฉพาะฝั่งเซิร์ฟเวอร์ (API routes)
SUPABASE_SERVICE_ROLE_KEY=

# --- ความปลอดภัย ---

# ใช้เซ็น session cookie และ challenge ของ passkey
# สุ่มด้วย: openssl rand -hex 32
SESSION_SECRET=

# ป้องกัน endpoint ที่ Vercel Cron เรียก (งานเตือนขาดงานรายวัน)
# สุ่มด้วย: openssl rand -hex 32
CRON_SECRET=

# --- โดเมน ---

# ⚠️ ใส่แค่ "โดเมน" เท่านั้น ห้ามมี path ต่อท้าย
#    ถูก:  https://taptime-three.vercel.app
#    ผิด:  https://taptime-three.vercel.app/admin   <- ลิงก์ในอีเมลจะพัง
#
# ตอน dev ใช้ http://localhost:3000
# (ค่านี้กำหนด rpID ของ passkey ด้วย ถ้าผิดพนักงานจะผูกอุปกรณ์ไม่ได้)
NEXT_PUBLIC_APP_URL=http://localhost:3000
