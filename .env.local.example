# ====================================================================
# TapTime — ตัวแปรสภาพแวดล้อม
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase
#   cp .env.local.example .env.local
#   (ใช้ cp ไม่ใช่ mv — จะได้เก็บไฟล์ตัวอย่างนี้ไว้)
#
# ค่าเดียวกันนี้ต้องใส่ใน Vercel → Settings → Environment Variables ด้วย
# ====================================================================

# --- Supabase (Project Settings → API) ---

# URL ของโปรเจกต์ เช่น https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (ใช้ตอน login และหน้าตั้งรหัสผ่าน)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — ห้ามเผยแพร่! ใช้เฉพาะฝั่งเซิร์ฟเวอร์ (API routes)
SUPABASE_SERVICE_ROLE_KEY=

# --- ความปลอดภัย ---

# ใช้เซ็น session cookie และ challenge ของ passkey
# สุ่มด้วย: openssl rand -hex 32
SESSION_SECRET=

# ป้องกัน endpoint ที่ Vercel Cron เรียก (งานเตือนขาดงานรายวัน)
# สุ่มด้วย: openssl rand -hex 32
CRON_SECRET=

# --- โดเมน ---

# ตอน dev ใช้ http://localhost:3000
# ตอน deploy เปลี่ยนเป็นโดเมนจริง เช่น https://taptime-three.vercel.app
# (ค่านี้กำหนด rpID ของ passkey ด้วย ถ้าผิดพนักงานจะผูกอุปกรณ์ไม่ได้)
NEXT_PUBLIC_APP_URL=http://localhost:3000
